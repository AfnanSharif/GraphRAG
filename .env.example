KNOWLEDGE_BASE_PATH=.local/knowledge-base.json
RAG_PROVIDER=local

# Optional LlamaIndex/OpenAI semantic RAG
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Neo4j publication
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional explicit RSS collection
RSS_TIMEOUT_SECONDS=10
RSS_MAX_ITEMS=25
RSS_USER_AGENT=MarketGraphResearchBot/1.0

# Optional real-time/search/web collection
SOURCE_TIMEOUT_SECONDS=10
# ALPHA_VANTAGE_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_MAX_ITEMS=10
WEB_MAX_CHARS=12000
